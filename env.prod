# Production overrides (NEVER commit real secrets here in practice)
APP_ENV=production
LOG_LEVEL=info
# Example: postgresql async URL (adjust host/user/pass/db)
DATABASE_URL=postgresql+asyncpg://app_user:CHANGE_ME@db:5432/app_db
# Provide a strong secret in real deployment via secret manager / env var
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_64CH
ENABLE_METRICS=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PASSWORD_HASH_UPGRADE=true

# Extended production overrides
KEY_ROTATION_GRACE_MINUTES=15
LOG_FORMAT=json
LOG_SINK=stdout
LOG_FIELDS_EXTRA=
PASSWORD_RESET_TOKEN_MINUTES=30
# Production embed allowlist intentionally empty; set explicit origins during deployment
EMBED_ALLOWLIST=
MAINT_WINDOW_ACTIVE=false
PERF_REGRESSION_WINDOW_MINUTES=5
RATE_LIMIT_TENANT_PER_MIN=500
RATE_LIMIT_IP_PER_MIN=50
EMBED_RATE_LIMIT_SCALE=1.0
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
AUTH_PROVIDERS_ENABLED=password
SESSION_INVALIDATION_MAX_SECONDS=60
BOOTSTRAP_BUDGET_MS=120000
SUPERACTION_ALERT_THRESHOLD=5
SUPERACTION_ALERT_WINDOW_MINUTES=10
EMBED_DOCS_OUTPUT_PATH=docs/embed/guide.md
POLICY_EVAL_LATENCY_BUCKETS=0.001,0.005,0.01,0.02,0.05,0.1,0.25,0.5,1,2
