# Auto-generated from config/descriptor.toml (FR-039)
# Copy to .env and fill in your values
#
# REFERENCE CONFIGURATIONS:
#   - env.dev: Development-focused defaults (PostgreSQL, debug logging, relaxed settings)
#   - env.prod: Production-focused defaults (PostgreSQL, secure settings, metrics enabled)
#   - env.test.postgres: PostgreSQL testing configuration (used by test suite)
#
# V1.0: SQLite support disabled - PostgreSQL only
#
# Usage:
#   cp .env.example .env              # Start with this template
#   # OR
#   cp env.dev .env                   # Use dev defaults
#   # OR
#   cp env.prod .env                  # Use production defaults (then customize secrets)
#
# These reference files are NOT automatically loaded - they serve as templates.
# The application loads .env (if present) or uses descriptor.toml defaults.

# ============================================================================
# APP
# ============================================================================

# Application name for logging and observability
# Type: string | Required: True | Secret: False
APP_NAME=githubspeckit-backend

# OpenTelemetry OTLP exporter endpoint (if set, uses OTLP; otherwise console)
# Type: string | Required: False | Secret: False
# OTEL_EXPORTER_OTLP_ENDPOINT=<STRING>

# Environment name (development, staging, production)
# Type: string | Required: True | Secret: False
ENVIRONMENT=development

# Enable debug mode (verbose logging, error details in responses)
# Type: bool | Required: False | Secret: False
# DEBUG=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Type: string | Required: False | Secret: False
# LOG_LEVEL=INFO

# ============================================================================
# DATABASE
# ============================================================================

# Database connection URL (V1.0: PostgreSQL only; SQLite support disabled)
# Type: string | Required: False | Secret: True
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/githubspeckit_dev

# Database connection pool size
# Type: int | Required: False | Secret: False
# DB_POOL_SIZE=10

# Maximum overflow connections beyond pool size
# Type: int | Required: False | Secret: False
# DB_MAX_OVERFLOW=20

# Connection pool timeout in seconds
# Type: int | Required: False | Secret: False
# DB_POOL_TIMEOUT=30

# Threshold in milliseconds for slow query logging (FR-034, FR-074, IMPL-DB-09)
# Type: int | Required: False | Secret: False
# DB_SLOW_QUERY_THRESHOLD_MS=100

# Echo SQL queries to stdout (development only)
# Type: bool | Required: False | Secret: False
# DB_ECHO_SQL=False

# ============================================================================
# AUTH
# ============================================================================

# Secret key for JWT signing and session management
# Type: string | Required: True | Secret: True
SECRET_KEY=<SECRET_VALUE>

# Minimum password length (C-001, FR-009)
# Type: int | Required: True | Secret: False
PASSWORD_MIN_LENGTH=12

# Enforce strict password complexity rules (uppercase, lowercase, digit, special)
# Type: bool | Required: True | Secret: False
PASSWORD_COMPLEXITY_STRICT=False

# JWT signing algorithm
# Type: string | Required: False | Secret: False
# JWT_ALGORITHM=HS256

# Access token expiration in minutes
# Type: int | Required: False | Secret: False
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiration in days
# Type: int | Required: False | Secret: False
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================================================
# OBSERVABILITY
# ============================================================================

# Enable OpenTelemetry tracing and metrics
# Type: bool | Required: False | Secret: False
# OTEL_ENABLED=False

# OpenTelemetry collector endpoint (e.g., http://localhost:4318)
# Type: string | Required: False | Secret: False
# OTEL_ENDPOINT=<STRING>

# Enable Prometheus metrics endpoint
# Type: bool | Required: False | Secret: False
# METRICS_ENABLED=True

# Prometheus metrics endpoint port
# Type: int | Required: False | Secret: False
# METRICS_PORT=9090

# ============================================================================
# SECURITY
# ============================================================================

# Comma-separated list of allowed CORS origins
# Type: string | Required: False | Secret: False
# CORS_ORIGINS=*

# Comma-separated list of allowed host headers
# Type: string | Required: False | Secret: False
# ALLOWED_HOSTS=*

# ============================================================================
# TESTING
# ============================================================================

# Test database connection URL
# Type: string | Required: False | Secret: True
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/githubspeckit_test

# ============================================================================
# PHOTO_STORAGE
# ============================================================================

# Photo storage backend type (local or s3)
# Type: string | Required: False | Secret: False
# STORAGE_TYPE=local

# Base path for local file storage (relative to project root)
# Type: string | Required: False | Secret: False
# LOCAL_BASE_PATH=data/photos

# S3 bucket name for photo storage (production only)
# Type: string | Required: False | Secret: False
# S3_BUCKET=<STRING>

# AWS region for S3 bucket
# Type: string | Required: False | Secret: False
# S3_REGION=<STRING>

# AWS access key ID for S3 (set in production)
# Type: string | Required: False | Secret: True
# S3_ACCESS_KEY_ID=<STRING>

# AWS secret access key for S3 (set in production)
# Type: string | Required: False | Secret: True
# S3_SECRET_ACCESS_KEY=<STRING>

# Maximum allowed file size for photo uploads in megabytes
# Type: int | Required: False | Secret: False
# MAX_UPLOAD_SIZE_MB=10

# ============================================================================
# SESSION
# ============================================================================

# Session storage backend type (cookie for dev, redis for production)
# Type: string | Required: False | Secret: False
# BACKEND=cookie

# Secret key for session encryption (must be 32+ characters)
# Type: string | Required: True | Secret: True
SECRET_KEY=<SECRET_VALUE>

# Session time-to-live in seconds (default: 1 hour)
# Type: int | Required: False | Secret: False
# TTL=3600

# Redis connection URL for session storage (production only)
# Type: string | Required: False | Secret: True
# REDIS_URL=redis://localhost:6379/0

# ============================================================================
# DEPRECATION
# ============================================================================

# Sunset date for tenant_id query parameter support (ISO 8601 format)
# Type: string | Required: False | Secret: False
# TENANT_QUERY_PARAM_SUNSET=2025-11-19
