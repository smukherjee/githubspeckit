# PostgreSQL Test Configuration
# This file configures PostgreSQL database for testing
# User: infysight_dbadmin / Password: infysight_dbadmin123

APP_ENV=test
LOG_LEVEL=info
DATABASE_URL=postgresql+asyncpg://infysight_dbadmin:infysight_dbadmin123@localhost/githubspeckit_test
JWT_SECRET=TEST_SECRET_DO_NOT_USE_IN_PRODUCTION
ENABLE_METRICS=true

# Test-specific settings
EMBED_ALLOWLIST=http://localhost:3000
MAINT_WINDOW_ACTIVE=false
KEY_ROTATION_GRACE_MINUTES=15
PERF_REGRESSION_WINDOW_MINUTES=5
RATE_LIMIT_TENANT_PER_MIN=500
RATE_LIMIT_IP_PER_MIN=50
EMBED_RATE_LIMIT_SCALE=1.0
PASSWORD_RESET_TOKEN_MINUTES=30
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=32768
ARGON2_PARALLELISM=2
AUTH_PROVIDERS_ENABLED=password
SESSION_INVALIDATION_MAX_SECONDS=60
BOOTSTRAP_BUDGET_MS=120000
SUPERACTION_ALERT_THRESHOLD=5
SUPERACTION_ALERT_WINDOW_MINUTES=10
POLICY_EVAL_LATENCY_BUCKETS=0.001,0.005,0.01,0.02,0.05,0.1,0.25,0.5,1,2
LOG_FORMAT=json
LOG_SINK=stdout
LOG_FIELDS_EXTRA=
