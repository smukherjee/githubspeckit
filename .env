# Base environment defaults (loaded in all modes)
APP_NAME=githubspeckit
APP_ENV=development
LOG_LEVEL=debug
API_HOST=0.0.0.0
API_PORT=8000
# Database (override in env.dev / env.prod as needed)
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Security / Auth
JWT_ISSUER=githubspeckit
JWT_AUDIENCE=githubspeckit-clients
JWT_EXPIRE_SECONDS=3600
JWT_REFRESH_EXPIRE_SECONDS=1209600
# Use a dev-only insecure secret by default; override in env.prod
JWT_SECRET=INSECURE_DEV_SECRET_CHANGE_ME
PASSWORD_HASH_UPGRADE=true
# Observability
ENABLE_METRICS=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Multi-tenancy / bootstrap
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPERADMIN_PASSWORD=ChangeMe123!
# Feature flags storage (placeholder)
FEATURE_FLAG_BACKEND=memory

# --- Extended Configuration Defaults ---
# Key rotation grace (minutes) (C-004 / FR-022)
KEY_ROTATION_GRACE_MINUTES=15
# Logging (FR-071)
LOG_FORMAT=json
LOG_SINK=stdout
LOG_FIELDS_EXTRA=
# Password reset token expiry (minutes) (C-008 / FR-060–FR-065)
PASSWORD_RESET_TOKEN_MINUTES=30
# Embed origins allowlist (comma-separated). Empty = no embeds allowed except dev override (C-012 / FR-053)
EMBED_ALLOWLIST=
# Maintenance window active flag (affects regression events) (C-013 / FR-074)
MAINT_WINDOW_ACTIVE=false
# Performance regression rolling window (minutes) (C-022 / FR-074)
PERF_REGRESSION_WINDOW_MINUTES=5
# Rate limiting defaults (C-002 / FR-023, FR-058)
RATE_LIMIT_TENANT_PER_MIN=500
RATE_LIMIT_IP_PER_MIN=50
EMBED_RATE_LIMIT_SCALE=1.0
# Argon2id hashing parameters (C-023 / FR-049, FR-051)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
# Auth providers enabled list (comma-separated) (FR-007 / C-024, C-036)
AUTH_PROVIDERS_ENABLED=password
# Session invalidation max delay after role downgrade (seconds) (C-032 / FR-021)
SESSION_INVALIDATION_MAX_SECONDS=60
# Bootstrap budget (ms) (C-034 / FR-052)
BOOTSTRAP_BUDGET_MS=120000
# Superadmin cross-tenant misuse alert thresholds (C-040 / FR-002 edge)
SUPERACTION_ALERT_THRESHOLD=5
SUPERACTION_ALERT_WINDOW_MINUTES=10
# Embed docs generator output (C-047 / FR-059)
EMBED_DOCS_OUTPUT_PATH=docs/embed/guide.md
# Policy evaluation latency histogram buckets (C-044 / FR-034)
# Comma-separated float seconds; keep in ascending order
POLICY_EVAL_LATENCY_BUCKETS=0.001,0.005,0.01,0.02,0.05,0.1,0.25,0.5,1,2
